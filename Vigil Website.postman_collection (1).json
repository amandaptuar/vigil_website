		},
		{
			"name": "4. Pricing — Stripe Checkout Session",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"planId\": \"{{planId}}\",\n  \"email\": \"website-user@example.com\",\n  \"successUrl\": \"http://your-website.com/#/success\",\n  \"cancelUrl\": \"http://your-website.com/#/pricing\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/payments/checkout-session",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"payments",
						"checkout-session"
					]
				},
				"description": "Creates a Stripe Checkout session for the selected plan. Returns `{ checkoutUrl }`. The frontend should redirect the user to this URL to complete payment on Stripe's hosted page.\n\nAfter payment Stripe fires a webhook to `POST /api/payments/webhook` which auto-assigns the subscription to the parent account."
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Checkout session created', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([200, 201, 400, 500]);",
							"});",
							"var res = pm.response.json();",
							"if (res.checkoutUrl) {",
							"  pm.collectionVariables.set('checkoutUrl', res.checkoutUrl);",
							"  console.log('Stripe checkout URL:', res.checkoutUrl);",
							"}"
						]
					}
				}
			]
		},
		{
			"name": "5. Contact — Submit Contact Form",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"name\": \"John Parent\",\n  \"email\": \"john@example.com\",\n  \"subject\": \"General Support\",\n  \"message\": \"Hello, I have a question about the Vigil app. How do I pair my child's device?\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{baseUrl}}/api/contact",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"contact"
					]
				},
				"description": "Public contact form endpoint. The Vigil website Contact page should call this instead of FormSubmit.co. Validates all fields, sends an email to the support inbox via Nodemailer.\n\nBody fields:\n- `name` (string, required)\n- `email` (valid email, required)\n- `subject` (string, required)\n- `message` (string, required)\n\nReturns `{ status: 200, message: 'Message sent successfully.' }`"
			},
			"event": [
				{
					"listen": "test",
					"script": {
						"type": "text/javascript",
						"exec": [
							"pm.test('Contact form submitted successfully', function () {",
							"  pm.expect(pm.response.code).to.be.oneOf([200, 500]);",
							"  if (pm.response.code === 200) {",
							"    var json = pm.response.json();",
							"    pm.expect(json.status).to.eql(200);",
							"  }",
							"});",
							"// 500 is expected if EMAIL_USER/EMAIL_PASS env vars aren't configured on test server"
						]
					}
				}
			]
		},

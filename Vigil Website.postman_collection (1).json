							],
							"path": [
								"api",
								"auth",
								"change-password-first-time"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"newPassword\": \"NewPass@1234\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"description": "Only relevant for accounts created BEFORE the fix (auto-generated temp password). New registrations set their real password directly at signup and never see this step."
					}
